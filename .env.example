# Copy to .env. Never commit .env or paste the key into the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DATAPATCH_MAX_STEPS=12
DATAPATCH_MAX_OUTPUT_TOKENS=8192
DATAPATCH_REQUEST_TIMEOUT=300
# Conservative USD estimates per million tokens, configurable for your provider.
DATAPATCH_INPUT_USD_PER_MILLION=0.30
DATAPATCH_OUTPUT_USD_PER_MILLION=1.20
DATAPATCH_RUN_BUDGET_USD=0.125
DATAPATCH_EVAL_BUDGET_USD=0.50

